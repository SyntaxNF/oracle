# https://docs.oracle.com/en/database/oracle/oracle-database/26/arpls/DBMS_STATS.html

# CASE TABLE
BEGIN DBMS_STATS.GATHER_TABLE_STATS(OWNNAME => owner, TABNAME => name, FORCE => FALSE); END;

# CASE TABLE_PARTITION
BEGIN DBMS_STATS.GATHER_TABLE_STATS(OWNNAME => owner, TABNAME => table, PARTNAME => name, FORCE => FALSE); END;

# CASE INDEX
BEGIN DBMS_STATS.GATHER_INDEX_STATS(OWNNAME => owner, INDNAME => name, FORCE => FALSE); END;

# CASE INDEX_PARTITION
BEGIN DBMS_STATS.GATHER_INDEX_STATS(OWNNAME => owner, INDNAME => table, PARTNAME => name, FORCE => FALSE); END;
