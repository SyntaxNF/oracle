# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/COMMENT.html

# CASE TABLE
COMMENT ON TABLE name IS { 'comment' | NULL }

# CASE COLUMN
COMMENT ON COLUMN name IS { 'comment' | NULL }

# CASE MATERIALIZED_VIEW
COMMENT ON MATERIALIZED VIEW name IS { 'comment' | NULL }

# CASE AUDIT_POLICY
COMMENT ON AUDIT POLICY name IS { 'comment' | NULL }

# CASE EDITION
COMMENT ON EDITION name IS { 'comment' | NULL }

# CASE INDEXTYPE
COMMENT ON INDEXTYPE name IS { 'comment' | NULL }

# CASE MINING_MODEL
COMMENT ON MINING MODEL name IS { 'comment' | NULL }

# CASE OPERATOR
COMMENT ON OPERATOR name IS { 'comment' | NULL }
