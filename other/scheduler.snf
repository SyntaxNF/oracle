# https://docs.oracle.com/en/database/oracle/oracle-database/19/arpls/DBMS_SCHEDULER.html

# CASE CREATE_JOB
BEGIN DBMS_SCHEDULER.CREATE_JOB(JOB_NAME => name, JOB_TYPE => job_type, JOB_ACTION => job_action, REPEAT_INTERVAL => repeat_interval, ENABLED => enabled, AUTO_DROP => auto_drop); END;

# CASE CREATE_PROGRAM
BEGIN DBMS_SCHEDULER.CREATE_PROGRAM(PROGRAM_NAME => name, PROGRAM_TYPE => program_type, PROGRAM_ACTION => program_action, NUMBER_OF_ARGUMENTS => number_of_arguments, ENABLED => enabled); END;

# CASE CREATE_SCHEDULE
BEGIN DBMS_SCHEDULER.CREATE_SCHEDULE(SCHEDULE_NAME => name, REPEAT_INTERVAL => repeat_interval); END;

# CASE DISABLE
BEGIN DBMS_SCHEDULER.DISABLE(NAME => name); END;

# CASE ENABLE
BEGIN DBMS_SCHEDULER.ENABLE(NAME => name); END;

# CASE SET_ATTRIBUTE
BEGIN DBMS_SCHEDULER.SET_ATTRIBUTE(NAME => name, ATTRIBUTE => attribute, VALUE => attribute_value); END;

# CASE DROP_JOB
BEGIN DBMS_SCHEDULER.DROP_JOB(JOB_NAME => name, FORCE => force); END;

# CASE DROP_PROGRAM
BEGIN DBMS_SCHEDULER.DROP_PROGRAM(PROGRAM_NAME => name, FORCE => force); END;

# CASE DROP_SCHEDULE
BEGIN DBMS_SCHEDULER.DROP_SCHEDULE(SCHEDULE_NAME => name, FORCE => force); END;

# PARTOFIS enabled
TRUE

FALSE

# PARTOFIS auto_drop
TRUE

FALSE

# PARTOFIS force
TRUE

FALSE
