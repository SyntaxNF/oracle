# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/AUDIT-Unified-Auditing.html

# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/AUDIT-Traditional-Auditing.html

# CASE UNIFIED_POLICY
AUDIT POLICY name
    [ { BY user [, ...] | EXCEPT user [, ...]
      | BY USERS WITH GRANTED ROLES role [, ...] } ]
    [ WHENEVER [ NOT ] SUCCESSFUL ]

# CASE UNIFIED_CONTEXT
AUDIT context_audit_clause [, ...] [ BY user [, ...] ]

# WHERE context_audit_clause
CONTEXT NAMESPACE namespace ATTRIBUTES attribute [, ...]

# CASE TRADITIONAL_STATEMENT
AUDIT { sql_statement_shortcut [, ...] | ALL | ALL STATEMENTS
    | system_privilege [, ...] | ALL PRIVILEGES }
    [ BY user [, ...] | IN SESSION CURRENT ]
    [ BY { SESSION | ACCESS } ]
    [ WHENEVER [ NOT ] SUCCESSFUL ]
    [ CONTAINER = { CURRENT | ALL } ]

# CASE TRADITIONAL_OBJECT
AUDIT { object_action [, ...] | ALL }
    ON { object | DIRECTORY directory | MINING MODEL mining_model
        | SQL TRANSLATION PROFILE translation_profile | DEFAULT }
    [ BY { SESSION | ACCESS } ]
    [ WHENEVER [ NOT ] SUCCESSFUL ]
    [ CONTAINER = { CURRENT | ALL } ]

# CASE TRADITIONAL_NETWORK
AUDIT NETWORK
    [ BY { SESSION | ACCESS } ]
    [ WHENEVER [ NOT ] SUCCESSFUL ]
    [ CONTAINER = { CURRENT | ALL } ]

# CASE TRADITIONAL_DIRECT_PATH
AUDIT DIRECT_PATH LOAD [ BY user [, ...] ]
    [ BY { SESSION | ACCESS } ]
    [ WHENEVER [ NOT ] SUCCESSFUL ]
    [ CONTAINER = { CURRENT | ALL } ]
