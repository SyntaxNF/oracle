# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/CREATE-ROLLBACK-SEGMENT.html

CREATE [ PUBLIC ] ROLLBACK SEGMENT name
    [ TABLESPACE tablespace ]
    [ STORAGE ( storage_option [...] ) ]

# ONEOFIS storage_option
INITIAL size_value [ K | M | G | T | P | E ]
NEXT size_value [ K | M | G | T | P | E ]
MINEXTENTS min_extents
MAXEXTENTS { max_extents | UNLIMITED }
OPTIMAL { size_value [ K | M | G | T | P | E ] | NULL }
