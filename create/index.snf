# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/CREATE-INDEX.html

# CASE TABLE
CREATE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE TABLE_UNIQUE
CREATE UNIQUE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    unique_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE TABLE_BITMAP
CREATE BITMAP INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    bitmap_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE LOCAL
CREATE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    local_index_clause
    partitioned_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE LOCAL_UNIQUE
CREATE UNIQUE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    local_index_clause
    unique_partitioned_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE LOCAL_BITMAP
CREATE BITMAP INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    bitmap_local_index_clause
    bitmap_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE GLOBAL_RANGE
CREATE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    GLOBAL PARTITION BY RANGE ( colname [, ...] )
    ( range_index_partition [, ...] )
    partitioned_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE GLOBAL_RANGE_UNIQUE
CREATE UNIQUE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    GLOBAL PARTITION BY RANGE ( colname [, ...] )
    ( range_index_partition [, ...] )
    unique_partitioned_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE GLOBAL_HASH
CREATE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    GLOBAL PARTITION BY HASH ( colname [, ...] )
    { ( hash_index_partition [, ...] )
    | PARTITIONS partition_count [ STORE IN ( tablespace [, ...] ) ] [ index_compression ] }
    partitioned_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE GLOBAL_HASH_UNIQUE
CREATE UNIQUE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    GLOBAL PARTITION BY HASH ( colname [, ...] )
    { ( hash_index_partition [, ...] )
    | PARTITIONS partition_count [ STORE IN ( tablespace [, ...] ) ] [ index_compression ] }
    unique_partitioned_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE CLUSTER
CREATE INDEX name ON CLUSTER cluster
    partitioned_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE BITMAP_JOIN
CREATE BITMAP INDEX name
    ON table ( join_index_column [, ...] )
    FROM join_table [, ...]
    WHERE boolean_expression
    [ bitmap_local_index_clause ]
    bitmap_index_attributes
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# CASE DOMAIN
CREATE INDEX name
    ON table [ table_alias ] ( index_column_expression [, ...] )
    INDEXTYPE IS indextype
    [ LOCAL [ ( domain_index_partition [, ...] ) ] ]
    [ parallel_clause ]
    [ PARAMETERS ( 'odci_parameters' ) ]
    [ USABLE | UNUSABLE ]
    [ { DEFERRED | IMMEDIATE } INVALIDATION ]

# WHERE index_column_expression
index_expression [ ASC | DESC ]

# WHERE join_index_column
[ table . | table_alias . ] colname [ ASC | DESC ]

# WHERE join_table
table [ table_alias ]

# WHERE range_index_partition
PARTITION [ partition ]
    VALUES LESS THAN ( { literal | MAXVALUE } [, ...] )
    segment_attributes

# WHERE hash_index_partition
PARTITION [ partition ]
    [ TABLESPACE tablespace ]
    [ index_compression ]

# PARTOFIS local_index_clause
LOCAL

LOCAL ( local_index_partition [, ...] )

LOCAL STORE IN ( tablespace [, ...] )
    [ ( local_index_partition [, ...] ) ]

# WHERE local_index_partition
PARTITION [ partition ]
    segment_attributes
    [ index_compression ]
    [ USABLE | UNUSABLE ]
    [ STORE IN ( tablespace [, ...] )
    | ( local_index_subpartition [, ...] ) ]

# WHERE hash_local_index_partition
PARTITION [ partition ] [ TABLESPACE tablespace ]
    [ index_compression ] [ USABLE | UNUSABLE ]

# WHERE local_index_subpartition
SUBPARTITION [ subpartition ] [ TABLESPACE tablespace ]
    [ index_compression ] [ USABLE | UNUSABLE ]

# WHERE domain_index_partition
PARTITION partition [ PARAMETERS ( 'odci_parameters' ) ]

# WHERE index_attributes
physical_attributes
[ TABLESPACE { tablespace | DEFAULT } ]
[ LOGGING | NOLOGGING ]
[ ONLINE ]
[ index_compression ]
[ SORT [ REVERSE ] | NOSORT | REVERSE ]
[ VISIBLE | INVISIBLE ]
[ INDEXING { FULL | PARTIAL } ]
[ parallel_clause ]

# WHERE partitioned_index_attributes
physical_attributes
[ TABLESPACE { tablespace | DEFAULT } ]
[ LOGGING | NOLOGGING ]
[ ONLINE ]
[ index_compression ]
[ SORT ] [ REVERSE ]
[ VISIBLE | INVISIBLE ]
[ INDEXING { FULL | PARTIAL } ]
[ parallel_clause ]

# WHERE unique_index_attributes
physical_attributes
[ TABLESPACE { tablespace | DEFAULT } ]
[ LOGGING | NOLOGGING ]
[ ONLINE ]
[ index_compression ]
[ SORT [ REVERSE ] | NOSORT | REVERSE ]
[ VISIBLE | INVISIBLE ]
[ INDEXING FULL ]
[ parallel_clause ]

# WHERE unique_partitioned_index_attributes
physical_attributes
[ TABLESPACE { tablespace | DEFAULT } ]
[ LOGGING | NOLOGGING ]
[ ONLINE ]
[ index_compression ]
[ SORT ] [ REVERSE ]
[ VISIBLE | INVISIBLE ]
[ INDEXING FULL ]
[ parallel_clause ]

# WHERE bitmap_index_attributes
physical_attributes
[ TABLESPACE { tablespace | DEFAULT } ]
[ LOGGING | NOLOGGING ]
[ ONLINE ]
[ SORT ]
[ VISIBLE | INVISIBLE ]
[ INDEXING { FULL | PARTIAL } ]
[ parallel_clause ]

# WHERE index_compression
{ COMPRESS [ prefix_length ] | COMPRESS ADVANCED [ LOW | HIGH ] | NOCOMPRESS }

# WHERE parallel_clause
{ NOPARALLEL | PARALLEL [ degree ] }

# WHERE physical_attributes
[ PCTFREE pctfree ]
[ INITRANS initrans ]
[ storage_clause ]

# WHERE segment_attributes
physical_attributes
[ TABLESPACE { tablespace | DEFAULT } ]
[ LOGGING | NOLOGGING ]

# WHERE storage_clause
STORAGE ( storage_option [...] )

# ONEOFIS storage_option
INITIAL size_value
NEXT size_value
MINEXTENTS min_extents
MAXEXTENTS { max_extents | UNLIMITED }
MAXSIZE { size_value | UNLIMITED }
PCTINCREASE pct_increase
FREELISTS freelists
FREELIST GROUPS freelist_groups
BUFFER_POOL { KEEP | RECYCLE | DEFAULT }
FLASH_CACHE { KEEP | NONE | DEFAULT }
CELL_FLASH_CACHE { KEEP | NONE | DEFAULT }

# WHERE size_value
size [ K | M | G | T | P | E ]

# PARTOFIS bitmap_local_index_clause
LOCAL

LOCAL ( bitmap_local_index_partition [, ...] )

LOCAL STORE IN ( tablespace [, ...] )
    [ ( bitmap_local_index_partition [, ...] ) ]

# WHERE bitmap_local_index_partition
PARTITION [ partition ]
    segment_attributes

    [ USABLE | UNUSABLE ]
    [ STORE IN ( tablespace [, ...] )
    | ( bitmap_local_index_subpartition [, ...] ) ]

# WHERE hash_bitmap_local_index_partition
PARTITION [ partition ] [ TABLESPACE tablespace ]
     [ USABLE | UNUSABLE ]

# WHERE bitmap_local_index_subpartition
SUBPARTITION [ subpartition ] [ TABLESPACE tablespace ]
     [ USABLE | UNUSABLE ]
