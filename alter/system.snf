# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/ALTER-SYSTEM.html

# CASE PARAMETER_SET
ALTER SYSTEM SET parameter_assignment [...]

# CASE PARAMETER_RESET
ALTER SYSTEM RESET parameter_reset [...]

# CASE STORED_OUTLINES
ALTER SYSTEM SET USE_STORED_OUTLINES = { TRUE | FALSE | category }

# CASE GLOBAL_TOPIC
ALTER SYSTEM SET GLOBAL_TOPIC_ENABLED = { TRUE | FALSE }

# CASE ARCHIVE_LOG
ALTER SYSTEM ARCHIVE LOG [ INSTANCE 'instance_name' ]
    { SEQUENCE sequence_value | CHANGE scn_value | CURRENT [ NOSWITCH ]
    | GROUP group_number | LOGFILE 'file_name' [ USING BACKUP CONTROLFILE ] | NEXT | ALL }
    [ TO 'location' ]

# CASE CHECKPOINT
ALTER SYSTEM CHECKPOINT [ GLOBAL | LOCAL ]

# CASE CHECK_DATAFILES
ALTER SYSTEM CHECK DATAFILES [ GLOBAL | LOCAL ]

# CASE DISTRIBUTED_RECOVERY
ALTER SYSTEM { ENABLE | DISABLE } DISTRIBUTED RECOVERY

# CASE FLUSH
ALTER SYSTEM FLUSH { SHARED_POOL | GLOBAL CONTEXT | BUFFER_CACHE | FLASH_CACHE
    | PASSWORDFILE_METADATA_CACHE }

# CASE FLUSH_REDO
ALTER SYSTEM FLUSH REDO TO target_database [ [ NO ] CONFIRM APPLY ]

# CASE DISCONNECT_SESSION
ALTER SYSTEM DISCONNECT SESSION 'session_id , serial_number'
    [ POST_TRANSACTION ] [ IMMEDIATE | NOREPLAY ]

# CASE KILL_SESSION
ALTER SYSTEM KILL SESSION 'session_id , serial_number [ , @ instance_id ]'
    [ IMMEDIATE | NOREPLAY ]

# CASE CANCEL_SQL
ALTER SYSTEM CANCEL SQL 'session_id , serial_number [ , @ instance_id ] [ , sql_id ]'

# CASE SWITCH_LOGFILE
ALTER SYSTEM SWITCH LOGFILE

# CASE SUSPEND_RESUME
ALTER SYSTEM { SUSPEND | RESUME }

# CASE QUIESCE
ALTER SYSTEM { QUIESCE RESTRICTED | UNQUIESCE }

# CASE RESTRICTED_SESSION
ALTER SYSTEM { ENABLE | DISABLE } RESTRICTED SESSION

# CASE DISPATCHER
ALTER SYSTEM SHUTDOWN [ IMMEDIATE ] dispatcher

# CASE REGISTER
ALTER SYSTEM REGISTER

# CASE RELOCATE_CLIENT
ALTER SYSTEM RELOCATE CLIENT client_id

# CASE ROLLING_MIGRATION
ALTER SYSTEM { START ROLLING MIGRATION TO 'asm_version' | STOP ROLLING MIGRATION }

# CASE ROLLING_PATCH
ALTER SYSTEM { START ROLLING PATCH | STOP ROLLING PATCH }

# CASE ENABLE_AFFINITY
ALTER SYSTEM ENABLE AFFINITY table [ SERVICE service ]

# CASE DISABLE_AFFINITY
ALTER SYSTEM DISABLE AFFINITY table

# WHERE parameter_assignment
parameter = parameter_value [, ...]
    [ COMMENT = 'comment' ] [ DEFERRED ]
    [ CONTAINER = { CURRENT | ALL } ]
    [ SCOPE = { MEMORY | SPFILE | BOTH } ] [ SID = { 'sid' | '*' } ]

# WHERE parameter_reset
parameter [ SCOPE = { MEMORY | SPFILE | BOTH } ] [ SID = { 'sid' | '*' } ]
