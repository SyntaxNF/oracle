# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/ALTER-TABLE.html

# CASE COLUMN_ADD
ALTER TABLE name ADD ( colname data_type [ DEFAULT default_expression ] [ NOT NULL ] )

# CASE COLUMN_DEFAULT
ALTER TABLE name MODIFY ( colname DEFAULT default_expression )

# CASE COLUMN_IDENTITY
ALTER TABLE name MODIFY ( colname GENERATED { ALWAYS | BY DEFAULT [ ON NULL ] } AS IDENTITY ( identity_options ) )

# CASE COLUMN_MODIFY
ALTER TABLE name MODIFY ( colname data_type [ DEFAULT default_expression ] )

# CASE COLUMN_NOT_NULL
ALTER TABLE name MODIFY ( colname NOT NULL )

# CASE COLUMN_NULL
ALTER TABLE name MODIFY ( colname NULL )

# CASE COLUMN_RENAME
ALTER TABLE name RENAME COLUMN colname TO new_colname

# CASE CONSTRAINT_ADD
ALTER TABLE name ADD CONSTRAINT constraint constraint_definition

# CASE CONSTRAINT_DISABLE
ALTER TABLE name DISABLE CONSTRAINT constraint

# CASE CONSTRAINT_ENABLE_NOVALIDATE
ALTER TABLE name ENABLE NOVALIDATE CONSTRAINT constraint

# CASE CONSTRAINT_ENABLE_VALIDATE
ALTER TABLE name ENABLE VALIDATE CONSTRAINT constraint

# CASE CONSTRAINT_RENAME
ALTER TABLE name RENAME CONSTRAINT constraint TO new_constraint

# CASE PARTITION_ADD
ALTER TABLE name ADD PARTITION partition partition_definition

# CASE PARTITION_EXCHANGE
ALTER TABLE name EXCHANGE PARTITION partition WITH TABLE referenced_schema . referenced_table { INCLUDING | EXCLUDING } INDEXES { WITH | WITHOUT } VALIDATION [ UPDATE GLOBAL INDEXES ]

# CASE PARTITION_MERGE
ALTER TABLE name MERGE PARTITIONS partition , other_partition INTO PARTITION new_partition [ UPDATE GLOBAL INDEXES ]

# CASE PARTITION_SPLIT
ALTER TABLE name SPLIT PARTITION partition split_clause INTO ( PARTITION other_partition , PARTITION new_partition ) [ UPDATE GLOBAL INDEXES ]

# CASE SUBPARTITION_ADD
ALTER TABLE name MODIFY PARTITION partition ADD SUBPARTITION subpartition partition_definition

# CASE SUBPARTITION_EXCHANGE
ALTER TABLE name EXCHANGE SUBPARTITION subpartition WITH TABLE referenced_schema . referenced_table { INCLUDING | EXCLUDING } INDEXES { WITH | WITHOUT } VALIDATION [ UPDATE GLOBAL INDEXES ]

# CASE SUBPARTITION_MERGE
ALTER TABLE name MERGE SUBPARTITIONS subpartition , other_partition INTO SUBPARTITION new_partition [ UPDATE GLOBAL INDEXES ]

# CASE SUBPARTITION_SPLIT
ALTER TABLE name SPLIT SUBPARTITION subpartition split_clause INTO ( SUBPARTITION other_partition , SUBPARTITION new_partition ) [ UPDATE GLOBAL INDEXES ]

# CASE TABLE_MOVE
ALTER TABLE name MOVE TABLESPACE tablespace

# CASE TABLE_READ_ONLY
ALTER TABLE name READ ONLY

# CASE TABLE_READ_WRITE
ALTER TABLE name READ WRITE

# CASE TABLE_RENAME
ALTER TABLE name RENAME TO new_name

# CASE DROP_COLUMN
ALTER TABLE name DROP COLUMN colname [ CASCADE CONSTRAINTS ]

# CASE DROP_CONSTRAINT
ALTER TABLE name DROP CONSTRAINT constraint [ CASCADE ]

# CASE DROP_PARTITION
ALTER TABLE name DROP PARTITION partition [ UPDATE GLOBAL INDEXES ]

# CASE DROP_SUBPARTITION
ALTER TABLE name DROP SUBPARTITION subpartition [ UPDATE GLOBAL INDEXES ]

# CASE TRUNCATE_PARTITION
ALTER TABLE name TRUNCATE PARTITION partition [ UPDATE GLOBAL INDEXES ]

# CASE TRUNCATE_SUBPARTITION
ALTER TABLE name TRUNCATE SUBPARTITION subpartition [ UPDATE GLOBAL INDEXES ]
