# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/ALTER-INDEX.html

# CASE INVISIBLE
ALTER INDEX name INVISIBLE

# CASE REBUILD
ALTER INDEX name REBUILD [ TABLESPACE tablespace ] [ PCTFREE pctfree ] [ INITRANS initrans ]
    [ LOGGING | NOLOGGING ] [ COMPRESS [ prefix_length ] | NOCOMPRESS ]
    [ ONLINE ] [ PARALLEL [ degree ] | NOPARALLEL ]

# CASE RENAME
ALTER INDEX name RENAME TO new_name

# CASE VISIBLE
ALTER INDEX name VISIBLE

# CASE PHYSICAL_ATTRIBUTES
ALTER INDEX name INITRANS initrans

# CASE LOGGING
ALTER INDEX name { LOGGING | NOLOGGING }

# CASE PARALLEL
ALTER INDEX name { NOPARALLEL | PARALLEL [ degree ] }

# CASE REBUILD_PARTITION
ALTER INDEX name REBUILD PARTITION partition [ TABLESPACE tablespace ]
    [ PCTFREE pctfree ] [ INITRANS initrans ] [ LOGGING | NOLOGGING ]
    [ COMPRESS [ prefix_length ] | NOCOMPRESS ] [ ONLINE ] [ PARALLEL [ degree ] | NOPARALLEL ]

# CASE REBUILD_SUBPARTITION
ALTER INDEX name REBUILD SUBPARTITION subpartition [ TABLESPACE tablespace ]
    [ ONLINE ] [ PARALLEL [ degree ] | NOPARALLEL ]
