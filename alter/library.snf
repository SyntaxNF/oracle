# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/ALTER-LIBRARY.html

# https://docs.oracle.com/en/database/oracle/oracle-database/19/lnpls/ALTER-LIBRARY-statement.html

# CASE COMPILE
ALTER LIBRARY name COMPILE [ DEBUG ]
    [ compiler_parameter_assignment [...] ]
    [ REUSE SETTINGS ]

# CASE EDITIONING
ALTER LIBRARY name { EDITIONABLE | NONEDITIONABLE }

# WHERE compiler_parameter_assignment
compiler_parameter = compiler_value
