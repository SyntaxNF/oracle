# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/ALTER-PROCEDURE.html

# CASE COMPILE
ALTER PROCEDURE name COMPILE [ DEBUG ]

    [ compiler_parameter_assignment [...] ] [ REUSE SETTINGS ]

# CASE EDITIONING
ALTER PROCEDURE name { EDITIONABLE | NONEDITIONABLE }

# WHERE compiler_parameter_assignment
compiler_parameter = compiler_value
