# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/ALTER-MATERIALIZED-VIEW-LOG.html

# CASE NEW_VALUES
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name { INCLUDING | EXCLUDING } NEW VALUES

# CASE ADD
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name
    ADD log_augmentation_item [, ...]
    [ { INCLUDING | EXCLUDING } NEW VALUES ]
    [ purge_clause ] [ for_refresh_clause ]

# CASE PURGE
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name purge_clause

# CASE REFRESH_TYPE
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name for_refresh_clause

# CASE PHYSICAL_ATTRIBUTES
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name physical_attributes
    [ purge_clause ] [ for_refresh_clause ]

# CASE PARALLEL
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name parallel_clause

# CASE LOGGING
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name { LOGGING | NOLOGGING }

# CASE CACHE
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name { CACHE | NOCACHE }

# CASE ALLOCATE_EXTENT
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name ALLOCATE EXTENT
    [ ( [ SIZE size_value ] [ DATAFILE 'file_name' ] [ INSTANCE instance_number ] ) ]

# CASE SHRINK
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name SHRINK SPACE [ COMPACT ] [ CASCADE ]

# CASE MOVE
ALTER MATERIALIZED VIEW LOG [ FORCE ] ON name MOVE
    [ physical_attributes ] [ TABLESPACE tablespace ] [ LOGGING | NOLOGGING ]
    [ parallel_clause ]

# PARTOFIS log_augmentation_item
{ OBJECT ID | PRIMARY KEY | ROWID | SEQUENCE } [ ( colname [, ...] ) ]

( colname [, ...] )

# PARTOFIS purge_clause
PURGE IMMEDIATE [ SYNCHRONOUS | ASYNCHRONOUS ]

PURGE START WITH datetime_expression
    [ NEXT next_datetime_expression | REPEAT INTERVAL interval_expression ]

PURGE { NEXT next_datetime_expression | REPEAT INTERVAL interval_expression }

# WHERE for_refresh_clause
{ FOR SYNCHRONOUS REFRESH USING staging_log_name | FOR FAST REFRESH }

# WHERE physical_attributes
[ PCTFREE pct_free ]
[ PCTUSED pct_used ]
[ INITRANS init_trans ]
[ STORAGE ( storage_options ) ]

# WHERE storage_options
[ NEXT size_value ]
[ MINEXTENTS min_extents ]
[ MAXEXTENTS { max_extents | UNLIMITED } ]
[ MAXSIZE { size_value | UNLIMITED } ]
[ PCTINCREASE pct_increase ]
[ FREELISTS freelists ]
[ BUFFER_POOL { KEEP | RECYCLE | DEFAULT } ]
[ FLASH_CACHE { KEEP | NONE | DEFAULT } ]
[ CELL_FLASH_CACHE { KEEP | NONE | DEFAULT } ]

# WHERE size_value
size [ K | M | G | T | P | E ]

# WHERE parallel_clause
{ NOPARALLEL | PARALLEL [ degree ] }
