# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/ALTER-SESSION.html

# CASE SET
ALTER SESSION SET parameter_assignment [...]

# CASE SET_EDITION
ALTER SESSION SET EDITION = edition

# CASE SET_CONTAINER
ALTER SESSION SET CONTAINER = container [ SERVICE = service ]

# CASE SET_ROW_ARCHIVAL_VISIBILITY
ALTER SESSION SET ROW ARCHIVAL VISIBILITY = { ACTIVE | ALL }

# CASE SET_COLLATION
ALTER SESSION SET DEFAULT COLLATION = { collate | NONE }

# CASE ADVISE
ALTER SESSION ADVISE { COMMIT | ROLLBACK | NOTHING }

# CASE CLOSE_DATABASE_LINK
ALTER SESSION CLOSE DATABASE LINK database_link

# CASE COMMIT_IN_PROCEDURE
ALTER SESSION { ENABLE | DISABLE } COMMIT IN PROCEDURE

# CASE GUARD
ALTER SESSION { ENABLE | DISABLE } GUARD

# CASE PARALLEL
ALTER SESSION { ENABLE | DISABLE | FORCE } PARALLEL { DML | DDL | QUERY } [ PARALLEL degree ]

# CASE ENABLE_RESUMABLE
ALTER SESSION ENABLE RESUMABLE [ TIMEOUT seconds ] [ NAME 'resumable_name' ]

# CASE DISABLE_RESUMABLE
ALTER SESSION DISABLE RESUMABLE

# CASE SHARD_DDL
ALTER SESSION { ENABLE | DISABLE } SHARD DDL

# CASE SYNC_WITH_PRIMARY
ALTER SESSION SYNC WITH PRIMARY

# WHERE parameter_assignment
session_parameter = parameter_value
