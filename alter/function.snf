# https://docs.oracle.com/en/database/oracle/oracle-database/19/sqlrf/ALTER-FUNCTION.html

# CASE COMPILE
ALTER FUNCTION name COMPILE [ DEBUG ]

    compiler_parameter_assignment [...] [ REUSE SETTINGS ]

# CASE EDITIONING
ALTER FUNCTION name { EDITIONABLE | NONEDITIONABLE }

# WHERE compiler_parameter_assignment
compiler_parameter = compiler_value
